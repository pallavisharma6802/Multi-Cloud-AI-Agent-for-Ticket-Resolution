aws_region = "us-east-1"

project_name = "multi-cloud-ai-agent"

db_username = "postgres_admin"
# Set via `TF_VAR_db_password` env var or a local terraform.tfvars (gitignored)
# instead of committing a real password -- see infra/README.md.
db_password = "CHANGE_ME"

# Never 0.0.0.0/0 -- see variables.tf. Example: your own IP in /32 form.
allowed_management_cidr_blocks = ["203.0.113.4/32"]
