# Copy to .env and fill in real values. .env is gitignored -- never commit it.
#
# See README.md's "Running locally" section for what's genuinely required
# vs. optional. Fields marked "unused at runtime" only exist for
# infra/*.tf Terraform variable parity -- app/config.py does not read them.

ENV=dev
PROJECT_NAME=multi-cloud-ai-agent

# --- Azure Text Analytics (required -- real NLP signals, see app/agents/azure_nlp_agent.py) ---
AZURE_TEXT_ANALYTICS_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_TEXT_ANALYTICS_KEY=<your-key>
# AZURE_SUBSCRIPTION_ID / AZURE_RESOURCE_GROUP: Terraform-only, unused at runtime.

# --- Pinecone (required -- vector KB storage, see app/embeddings/pinecone_client.py) ---
PINECONE_API_KEY=<your-key>
PINECONE_ENVIRONMENT=<your-environment>
PINECONE_INDEX_NAME=ticket-kb

# --- Ollama (required) ---
# Docker Compose overrides this to http://ollama:11434 automatically for
# containerized runs (see docker-compose.yml) -- set this for non-Docker
# local dev (e.g. Ollama running natively on your machine).
OLLAMA_BASE_URL=http://localhost:11434

# --- Database (required) ---
# Docker Compose overrides this automatically for containerized runs.
DATABASE_URL=postgresql://ticket_admin:ticket_local_dev@localhost:5432/tickets_db

# --- Domain pack (optional, defaults to it_saas) ---
DOMAIN_PACK=it_saas

# --- BigQuery analytics sink (optional, defaults to disabled -- Phase 4) ---
ENABLE_BIGQUERY=false
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_DATASET=ticket_analytics
BIGQUERY_TABLE=fact_ticket_events

# --- AWS / Bedrock: Terraform-only, unused at runtime (see app/config.py) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Misc ---
LOG_LEVEL=INFO

# --- docker-compose.yml only (Phase 7) -- read by Compose for variable
# substitution, not by the FastAPI app itself ---
POSTGRES_USER=ticket_admin
POSTGRES_PASSWORD=ticket_local_dev
POSTGRES_DB=tickets_db
OLLAMA_MODEL=qwen2.5:3b
GRAFANA_ADMIN_PASSWORD=admin
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
# Grafana's BigQuery datasource JWT auth (see grafana/README.md) -- only
# needed if you also set ENABLE_BIGQUERY=true above with real credentials.
BIGQUERY_CLIENT_EMAIL=
BIGQUERY_PRIVATE_KEY=
