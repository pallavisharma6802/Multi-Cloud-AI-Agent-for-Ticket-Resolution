# Copy to .env and fill in real values. .env is gitignored -- never commit it.
#
# See README.md's "Running locally" section for what's genuinely required
# vs. optional. Fields marked "unused at runtime" only exist for
# infra/*.tf Terraform variable parity -- app/config.py does not read them.

ENV=dev
PROJECT_NAME=multi-cloud-ai-agent

# --- Azure Text Analytics (required -- real NLP signals, see app/agents/azure_nlp_agent.py) ---
AZURE_TEXT_ANALYTICS_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_TEXT_ANALYTICS_KEY=<your-key>
# AZURE_SUBSCRIPTION_ID / AZURE_RESOURCE_GROUP: Terraform-only, unused at runtime.

# --- Pinecone (required -- vector KB storage, see app/embeddings/pinecone_client.py) ---
PINECONE_API_KEY=<your-key>
PINECONE_ENVIRONMENT=<your-environment>
PINECONE_INDEX_NAME=ticket-kb

# --- Amazon Bedrock (required -- sole LLM transport via Converse / Nova) ---
AWS_REGION=us-east-1
# Per-role Bedrock model IDs. Micro = amazon.nova-micro-v1:0 for cheaper/faster roles.
MODEL_INTENT_PRIORITY=amazon.nova-lite-v1:0
MODEL_GRADER=amazon.nova-lite-v1:0
MODEL_JUDGE=amazon.nova-lite-v1:0
MODEL_CONTINUATION=amazon.nova-lite-v1:0
MODEL_DRAFTING=amazon.nova-lite-v1:0
MODEL_SUPERVISOR=amazon.nova-lite-v1:0
# Optional explicit keys; otherwise use ADC / instance role / `aws configure`.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# REQUEST_TIMEOUT_SECONDS applies to Bedrock boto3 connect/read timeouts.
REQUEST_TIMEOUT_SECONDS=180

# --- Database (required) ---
# Docker Compose overrides this automatically for containerized runs.
DATABASE_URL=postgresql://ticket_admin:ticket_local_dev@localhost:5432/tickets_db

# --- Domain pack (optional, defaults to it_saas) ---
DOMAIN_PACK=it_saas

# --- Pipeline latency knobs ---
INTENT_NUM_SAMPLES=1
RETRIEVAL_TOP_K=3
MAX_QUERY_REWRITES=1
MAX_WALL_CLOCK_SECONDS=900

# --- BigQuery analytics sink (optional, defaults to disabled -- Phase 4) ---
ENABLE_BIGQUERY=false
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_DATASET=ticket_analytics
BIGQUERY_TABLE=fact_ticket_events

# --- LangSmith tracing (optional, opt-in -- traces the LangGraph supervisor's
# node-by-node execution at smith.langchain.com. Off by default; the app
# runs identically with these unset. Sign up and create a key at
# https://smith.langchain.com if you don't have one. ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ticket-agent

# --- Travel booking demo: real data via SerpApi's Google Flights/Hotels
# APIs (optional -- defaults to the simulated dataset in travel_booking/data/).
# Free self-serve signup at serpapi.com, no official Google API exists for
# this so SerpApi (which queries Google's real results) is the closest
# real equivalent. See travel_booking/agents/serpapi_client.py. ---
SERPAPI_API_KEY=
TRAVEL_DATA_SOURCE=simulated

# --- Misc ---
LOG_LEVEL=INFO

# --- docker-compose.yml only -- read by Compose for variable
# substitution, not by the FastAPI app itself ---
POSTGRES_USER=ticket_admin
POSTGRES_PASSWORD=ticket_local_dev
POSTGRES_DB=tickets_db
GRAFANA_ADMIN_PASSWORD=admin
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
# Grafana's BigQuery datasource JWT auth (see grafana/README.md) -- only
# needed if you also set ENABLE_BIGQUERY=true above with real credentials.
BIGQUERY_CLIENT_EMAIL=
BIGQUERY_PRIVATE_KEY=
